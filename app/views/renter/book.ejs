<%- include('../partials/web-open') %>
<div class="narrow">
<%- include('../partials/topbar', { heading: 'Book this room', back: '/rooms/' + property.id }) %>
<% const minDate = new Date(Math.max(Date.now(), new Date(property.availableFrom || 0).getTime())).toISOString().slice(0, 10); %>
<form method="post" action="/rooms/<%= property.id %>/book" style="display:contents">
<div class="pad">
  <div class="ctx-card"><img src="<%= property.photos[0] || '' %>" alt="" onerror="this.style.visibility='hidden'"><div><b><%= property.title %></b><small><%= property.location %></small><small><b><%= H.money(property.monthlyRent) %></b> / month</small></div></div>
  <label class="field"><span>Move-in date</span><div class="input"><%- H.ic('calendar', 18) %><input type="date" name="moveInDate" min="<%= minDate %>" value="<%= minDate %>" required></div></label>
  <div class="field"><span>Rental period</span><div class="pills">
    <% [6, 12, 24].forEach(m => { %><label class="pill <%= m === 12 ? 'on' : '' %>"><input type="radio" name="months" value="<%= m %>" <%= m === 12 ? 'checked' : '' %> hidden><%= m %> months</label><% }) %>
  </div></div>
  <label class="field"><span>Note to the owner (optional)</span><textarea name="note" rows="3" placeholder="Tell the owner about yourself or your move-in plan."></textarea></label>
  <dl class="kv">
    <dt>Monthly rent</dt><dd><%= H.money(property.monthlyRent) %></dd>
    <dt>Owner</dt><dd><%= property.owner ? property.owner.name : '' %></dd>
    <dt>Available from</dt><dd><%= H.fmtDate(property.availableFrom) %></dd>
  </dl>
  <div class="note info"><%- H.ic('shield', 16) %> No payment is taken here. The owner reviews your request and accepts or rejects it. Once accepted, the room is confirmed for you and you arrange the move-in together.</div>
</div>
<div class="sticky-cta"><button class="btn primary block" type="submit">Send booking request</button></div>
</form>
</div>
<%- include('../partials/web-close') %>
